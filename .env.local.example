# URL de la API backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# URL pública de la web (se usa en los enlaces de los emails)
SITE_URL=http://localhost:3000

# Base de datos de la lista de espera (personas, convocatorias, emails enviados, clics a WhatsApp)
DATABASE_URL=postgres://embudo:embudo@localhost:5432/embudo

# Resend (envío de emails). Sin RESEND_API_KEY los emails se muestran en consola en vez de enviarse
RESEND_API_KEY=
EMAIL_FROM="Adrià Estévez <adria@mail.arquitectos-ia.com>"
# Dónde te llegan las respuestas a los emails
EMAIL_REPLY_TO=

# Usuario y contraseña del panel /embudo (contraseña de 24+ caracteres: openssl rand -base64 32)
ADMIN_USER=adria
ADMIN_PASSWORD=cambia-esto
